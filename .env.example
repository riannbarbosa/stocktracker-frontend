# Where the dev server forwards /api/* (stocktracker-api).
API_PROXY_TARGET=http://localhost:3000

# Base URL the browser calls. Leave unset to go through the /api proxy.
# VITE_API_URL=https://api.example.com

# Cloudflare Turnstile site key, shown on sign-up and forgot-password. Must pair
# with the API's TURNSTILE_SECRET_KEY; leave both unset to turn the check off.
# Test key that always passes: 1x00000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=
